# ===== Copy thành .env (make env) — KHÔNG commit .env =====
# Các giá trị dưới đây chỉ dùng cho máy dev.

# ---- Phiên bản image (đổi ở đây nếu cần ghim phiên bản khác) ----
POSTGRES_VERSION=16
REDIS_VERSION=7.4
KAFKA_VERSION=3.8.0
KONG_VERSION=3.8
# MinIO: Docker Hub không còn image mới, dùng Chainguard (đã kiểm chứng chạy được trên máy dev)
MINIO_IMAGE=cgr.dev/chainguard/minio:latest
MINIO_MC_IMAGE=cgr.dev/chainguard/minio-client:latest-dev

# ---- PostgreSQL admin (chỉ dùng để tạo DB/user, service KHÔNG dùng) ----
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_admin_dev

# ---- Mật khẩu user riêng của từng service (mỗi service 1 DB + 1 user) ----
DB_PASSWORD_IDENTITY=identity_dev
DB_PASSWORD_EVENT=event_dev
DB_PASSWORD_BOOKING=booking_dev
DB_PASSWORD_PAYMENT=payment_dev
DB_PASSWORD_TICKET=ticket_dev
DB_PASSWORD_RESALE=resale_dev
DB_PASSWORD_MERCH=merch_dev
DB_PASSWORD_NOTIFICATION=notification_dev
DB_PASSWORD_FINANCE=finance_dev
DB_PASSWORD_AI=ai_dev

# ---- MinIO ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev

# ---- Chuỗi kết nối mẫu cho service (copy sang .env của từng service) ----
# identity : postgresql://identity_user:identity_dev@localhost:5432/identity_db
# booking  : postgresql://booking_user:booking_dev@localhost:5432/booking_db
# Redis    : redis://localhost:6379
# Kafka    : localhost:9092 (từ máy host) | kafka:29092 (từ container)
# SMTP     : localhost:1025 (Mailpit UI: http://localhost:8025)
