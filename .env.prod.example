# Copy ra /etc/ticketing/.env.prod; điền secret trên VPS, không commit file thật.
# Digest đã docker pull thành công ngày 2026-10-28; đổi digest phải pull và review lại.
POSTGRES_IMAGE=postgres:16-alpine@sha256:0cefaabd882e42bcb2a2f3dc56d3ce4770560ba62fd7f197f1a2e008fd5731ab
REDIS_IMAGE=redis:7.4-alpine@sha256:6ba19c50b56777f5c11c58eff8ddb69d0d5f27ba131cffb63f180ccfd43c66af
KAFKA_IMAGE=apache/kafka:3.8.0@sha256:c89f315cff967322c5d2021434b32271393cb193aa7ec1d43e97341924e57069
KONG_IMAGE=kong:3.8@sha256:c36bf02a89bd660b785986b40c0e5e139f45b8552fa6da199f05061e1f0bfa22
MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:e70b2b1e74d79457f808710483bd726ff364529ca30736eaa15a6ab547d3a5a7

# Chỉ cần khi bật overlay tunnel. Đã pull amd64 ngày 2026-11-25.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.11.0@sha256:b94b96edf2c9c4360f8879c8580cfaa99077f19c849ec595ca2f711b27d4f344
# Token không nằm trong env: truyền đường dẫn file ngoài Git qua deploy.sh --tunnel.

# User quản trị chỉ để bootstrap, service nghiệp vụ dùng <service>_user.
