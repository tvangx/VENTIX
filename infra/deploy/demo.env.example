# Additional --env-file, AFTER the unchanged infra env. Never commit the filled file.
# Release is written by package-demo.ps1 into release.env; do not reuse a release tag.
DEMO_ORIGIN=https://ventixxx.dpdns.org
INTERNAL_API_KEY=
ADMISSION_TOKEN_SECRET=
# Persistent PKCS8 RSA >=2048, single quoted, literal \n between PEM lines.
JWT_PRIVATE_KEY_PEM=
TICKET_ACTIVE_KEY_ID=demo-v1
# Single quoted JSON: {"demo-v1":"<canonical base64 32 bytes>"}
TICKET_ENCRYPTION_KEYS=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Overlay fixes VNPAY_ENABLED=true and explicitly selects this supplied sandbox endpoint:
# VNPAY_PAYMENT_URL=https://sandbox.vnpaytest.vn/paymentv2/vpcpay.html
# VNPAY_RETURN_URL=https://ventixxx.dpdns.org/payments/return (real frontend route)
# VNPAY_IPN_URL=https://ventixxx.dpdns.org/api/payment/v1/payments/vnpay/ipn
