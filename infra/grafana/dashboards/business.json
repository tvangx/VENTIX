{
  "uid": "ventix-business",
  "title": "VENTIX — Business",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": ["ventix", "T-501"],
  "panels": [
    {
      "id": 1,
      "title": "Seat hold outcomes (No data until Booking is deployed/scraped)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(seat_hold_requests_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": { "defaults": { "noValue": "No data" }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Refund outcomes",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(refunds_total[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "noValue": "No data" }, "overrides": [] }
    }
  ]
}
