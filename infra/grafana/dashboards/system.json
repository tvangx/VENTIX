{
  "uid": "ventix-system",
  "title": "VENTIX — System",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "tags": ["ventix", "T-501"],
  "panels": [
    {
      "id": 1,
      "title": "Exporter targets (0 = down / not configured)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"exporters|postgres\"}",
          "legendFormat": "{{exporter}} {{cluster}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "title": "Redis connected clients",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "refId": "A", "expr": "redis_connected_clients", "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": { "defaults": { "noValue": "No data" }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "Kafka brokers",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [{ "refId": "A", "expr": "kafka_brokers", "instant": true }],
      "fieldConfig": { "defaults": { "noValue": "No data" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "PostgreSQL reachable per cluster (pg_up; 0 = DB down / auth failed)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up{job=\"postgres\"}",
          "legendFormat": "{{cluster}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 5,
      "title": "PostgreSQL connections by cluster/database",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, datname) (pg_stat_database_numbackends{job=\"postgres\"})",
          "legendFormat": "{{cluster}}/{{datname}}"
        },
        {
          "refId": "B",
          "expr": "max by (cluster) (pg_settings_max_connections{job=\"postgres\"})",
          "legendFormat": "{{cluster}} max_connections"
        }
      ],
      "fieldConfig": { "defaults": { "noValue": "No data" }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "PostgreSQL database size by cluster/database",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (cluster, datname) (pg_database_size_bytes{job=\"postgres\"})",
          "legendFormat": "{{cluster}}/{{datname}}"
        }
      ],
      "fieldConfig": { "defaults": { "noValue": "No data", "unit": "bytes" }, "overrides": [] }
    }
  ]
}
