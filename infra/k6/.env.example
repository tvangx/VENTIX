# Truyền bằng environment hoặc k6 -e; k6 không tự đọc file này.
# 5000..10000 cho G1; số nhỏ chỉ dùng smoke, không dùng để nghiệm thu G1.
USERS=5000
SEATS=2000
BASE_URL=http://localhost:3003
# Qua Kong local loadtest: http://localhost:8000/api/booking
# Tạo event UUID mới bằng node scripts/seed-s1-event.mjs mỗi lần chạy.
EVENT_ID=
# Đường dẫn tuyệt đối tới secrets/<run>/tokens.json; không commit token/khóa.
TOKENS_FILE=
