# Chỉ booking_user / booking_db (env schema từ chối user hoặc database khác).
DATABASE_URL=postgresql://booking_user:booking_dev@localhost:5432/booking_db
PORT=3003
NODE_ENV=development
LOG_LEVEL=info
# LOG_FILE_PATH=/var/log/ticketing/booking.log
# LOG_FILE_MAX_BYTES=10485760
# LOG_FILE_MAX_FILES=3

REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
EVENT_CONSUMER_GROUP_ID=booking-event-lifecycle
EVENT_CONSUMER_ENABLED=true
EVENT_INTERNAL_URL=http://localhost:3002
INTERNAL_API_KEY=local-dev-internal-key-change-me
ORDER_PAYMENT_WINDOW_SECONDS=900
ORDER_EXPIRY_GRACE_SECONDS=30
MERCH_INTERNAL_URL=http://localhost:3007
MERCH_QUOTE_TIMEOUT_MS=800
# Seed dev: file JSON [{"seat_id":"uuid","ticket_class_id":"uuid"}], snapshot phải tồn tại.
# SEED_EVENT_ID=11111111-1111-4111-8111-111111111111
# SEED_SEAT_MAP_VERSION=1
# SEED_SEATS_FILE=./synthetic-seats.json
REHYDRATE_ENABLED=true
# T-203 script dữ liệu giả (pnpm --filter @ticketing/booking event:fake), các ID ngẫu nhiên nếu bỏ trống.
# FAKE_EVENT_ID=11111111-1111-4111-8111-111111111111
# FAKE_ORGANIZER_ID=22222222-2222-4222-8222-222222222222
# FAKE_CLASS_ID=33333333-3333-4333-8333-333333333333
# FAKE_EVENT_VERSION=1
# FAKE_SEAT_MAP_VERSION=1
HOLD_TTL_SECONDS=600
HOLD_MAX_SEATS=6
# Waiting Room: sinh secret riêng >=32 ký tự, không commit .env hay secret thật.
ADMISSION_REQUIRED=true
ADMISSION_TOKEN_SECRET=
ADMISSION_TOKEN_TTL_SECONDS=600
ADMISSION_MAX_ACTIVE=1000
QUEUE_TTL_SECONDS=86400
QUEUE_MAX_STREAMS=1000
QUEUE_WORKER_ENABLED=true
# Chỉ bật cho kiểm chứng T-205, không bật trong production.
HOLDLOG_ENABLED=false

# Xác thực JWT (ADR-0004). Chọn MỘT:
#  - AUTH_JWKS_URI: JWKS của identity-service (dùng cho mọi môi trường thật)
#  - AUTH_PUBLIC_KEY_PEM: khóa công khai PEM, CHỈ dev/test (bị cấm khi NODE_ENV=production)
AUTH_ISSUER=https://identity.ticketing.local
AUTH_AUDIENCE=ticketing-api
AUTH_JWKS_URI=http://localhost:3001/.well-known/jwks.json
# AUTH_PUBLIC_KEY_PEM=

# Chỉ bật OpenTelemetry khi đặt biến này (ví dụ http://localhost:4318)
# OTEL_EXPORTER_OTLP_ENDPOINT=
