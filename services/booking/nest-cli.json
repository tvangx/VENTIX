{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "tsConfigPath": "tsconfig.build.json",
    "deleteOutDir": true,
    "assets": [
      "seat-hold/lua/*.lua",
      "rehydrate/lua/*.lua",
      "seat-status/lua/*.lua",
      "checkout/lua/*.lua",
      "queue/lua/*.lua"
    ],
    "watchAssets": true
  }
}
