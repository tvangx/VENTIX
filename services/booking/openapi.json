{
  "openapi": "3.0.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "summary": "Process is up",
        "tags": ["health"]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable (problem+json, code NOT_READY)"
          }
        },
        "summary": "Ready to serve traffic (checks the database)",
        "tags": ["health"]
      }
    },
    "/v1/whoami": {
      "get": {
        "operationId": "WhoamiController_whoami",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoamiResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token (problem+json)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Return the authenticated principal",
        "tags": ["whoami"]
      }
    },
    "/v1/holds": {
      "post": {
        "operationId": "SeatHoldController_hold",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Holds are idempotent by user/event/seat. Every successful repeat renews TTL, including requests with the same header; no cached response is replayed.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Admission-Token",
            "in": "header",
            "description": "Required for queue-enabled sale phases; HS256 token from queue status SSE",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateHoldDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HoldResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input (application/problem+json)"
          },
          "401": {
            "description": "Missing or invalid JWT (application/problem+json)"
          },
          "403": {
            "description": "ADMISSION_REQUIRED (application/problem+json)"
          },
          "404": {
            "description": "EVENT_NOT_ON_SALE (application/problem+json)"
          },
          "409": {
            "description": "SEAT_UNAVAILABLE with seat_id (application/problem+json)"
          },
          "422": {
            "description": "HOLD_LIMIT_EXCEEDED (application/problem+json)"
          },
          "503": {
            "description": "EVENT_NOT_READY or SEAT_HOLD_UNAVAILABLE; Retry-After: 1 (application/problem+json)",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "example": 1
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Atomically hold all requested seats; repeated requests renew their TTL",
        "tags": ["holds"]
      },
      "get": {
        "operationId": "SeatHoldController_current",
        "parameters": [
          {
            "name": "event_id",
            "required": true,
            "in": "query",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentHoldResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input (application/problem+json)"
          },
          "401": {
            "description": "Missing or invalid JWT (application/problem+json)"
          },
          "503": {
            "description": "EVENT_NOT_READY or SEAT_HOLD_UNAVAILABLE; Retry-After: 1 (application/problem+json)",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "example": 1
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Read active seats held by the current user in one event",
        "tags": ["holds"]
      },
      "delete": {
        "operationId": "SeatHoldController_release",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReleaseHoldDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          },
          "400": {
            "description": "Invalid input (application/problem+json)"
          },
          "401": {
            "description": "Missing or invalid JWT (application/problem+json)"
          },
          "503": {
            "description": "EVENT_NOT_READY or SEAT_HOLD_UNAVAILABLE; Retry-After: 1 (application/problem+json)",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "example": 1
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Release specified seats, or all seats held by the current user in one event",
        "tags": ["holds"]
      }
    },
    "/v1/events/{id}/seat-status": {
      "get": {
        "operationId": "SeatStatusController_snapshot",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeatStatusDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid event UUID (application/problem+json)"
          },
          "401": {
            "description": "Missing or invalid JWT (application/problem+json)"
          },
          "503": {
            "description": "SEAT_STATUS_UNAVAILABLE; Retry-After: 1 (application/problem+json)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Read sold and active held seat IDs from Redis indexes",
        "tags": ["seat-status"]
      }
    },
    "/v1/events/{id}/seat-stream": {
      "get": {
        "description": "event: snapshot has {sold,held,as_of}; event: delta has a JSON string array such as [\"H:<seatId>\",\"A:<seatId>\",\"S:<seatId>\"]. Last state per seat wins within a batch. No replay/Last-Event-ID support. Requires Authorization bearer header.",
        "operationId": "SeatStatusController_stream",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "X-Admission-Token",
            "in": "header",
            "description": "Required for queue-enabled sale phases; HS256 token from queue status SSE",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": ""
          },
          "400": {
            "description": "Invalid event UUID (application/problem+json)"
          },
          "401": {
            "description": "Missing or invalid JWT (application/problem+json)"
          },
          "403": {
            "description": "ADMISSION_REQUIRED while waiting room is enabled (application/problem+json)"
          },
          "503": {
            "description": "SEAT_STATUS_UNAVAILABLE; Retry-After: 1 (application/problem+json)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Initial snapshot then seat deltas batched every 500 ms; reconnect for a fresh snapshot",
        "tags": ["seat-status"]
      }
    },
    "/v1/checkout": {
      "post": {
        "operationId": "CheckoutController_checkout",
        "parameters": [
          {
            "name": "idempotency-key",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Admission-Token",
            "in": "header",
            "description": "Required for queue-enabled sale phases; HS256 token from queue status SSE",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing Idempotency-Key"
          },
          "401": {
            "description": "JWT required"
          },
          "403": {
            "description": "ADMISSION_REQUIRED"
          },
          "409": {
            "description": "EVENT_NOT_ON_SALE, HOLD_NOT_FOUND, SEAT_UNAVAILABLE, TICKET_UNAVAILABLE"
          },
          "422": {
            "description": "VOUCHER_NOT_SUPPORTED, IDEMPOTENCY_KEY_REUSED, INVALID_TICKET_CLASS"
          },
          "503": {
            "description": "EVENT_NOT_READY, MERCH_UNAVAILABLE, SEAT_HOLD_UNAVAILABLE",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "example": 1
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Convert held seats and GA/merch items into an order at server prices",
        "tags": ["checkout"]
      }
    },
    "/v1/queue/join": {
      "post": {
        "operationId": "QueueController_join",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Idempotency is by JWT user/event via ZADD NX; header does not create another place",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueueEventDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatusDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid event UUID (application/problem+json)"
          },
          "401": {
            "description": "JWT required (application/problem+json)"
          },
          "404": {
            "description": "EVENT_NOT_ON_SALE (application/problem+json)"
          },
          "503": {
            "description": "QUEUE_UNAVAILABLE (application/problem+json); Retry-After: 1"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Join Waiting Room once per authenticated user/event; repeats keep FIFO order",
        "tags": ["queue"]
      }
    },
    "/v1/queue/status": {
      "get": {
        "description": "event: status with QueueStatusDto. Terminal admitted/disabled/not_joined closes stream. Reconnect replays the same unexpired grant. Requires Authorization header; tokens never appear in URL. Post-header errors use event: error with code then close.",
        "operationId": "QueueController_status",
        "parameters": [
          {
            "name": "event_id",
            "required": true,
            "in": "query",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": ""
          },
          "400": {
            "description": "Invalid event UUID (application/problem+json)"
          },
          "401": {
            "description": "JWT required (application/problem+json)"
          },
          "404": {
            "description": "EVENT_NOT_ON_SALE (application/problem+json)"
          },
          "503": {
            "description": "QUEUE_UNAVAILABLE (application/problem+json); Retry-After: 1"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Stream private queue position once per second, then admission token",
        "tags": ["queue"]
      }
    },
    "/v1/orders/{orderId}": {
      "get": {
        "operationId": "OrderReadController_get",
        "parameters": [
          {
            "name": "orderId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderView"
                }
              }
            }
          },
          "401": {
            "description": "JWT required"
          },
          "404": {
            "description": "ORDER_NOT_FOUND; absent or not owned"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Read an order owned by the authenticated user",
        "tags": ["orders"]
      }
    }
  },
  "info": {
    "title": "booking service",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": ["status"]
      },
      "WhoamiResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "roles": {
            "example": ["USER"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "organizerId": {
            "type": "string"
          }
        },
        "required": ["userId", "roles"]
      },
      "CreateHoldDto": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "seat_ids": {
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": ["event_id", "seat_ids"]
      },
      "HoldResponseDto": {
        "type": "object",
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "seat_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": ["expires_at", "seat_ids"]
      },
      "CurrentHoldResponseDto": {
        "type": "object",
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Earliest seat expiry; null when no active hold exists"
          },
          "seat_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": ["expires_at", "seat_ids"]
      },
      "ReleaseHoldDto": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "seat_ids": {
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true,
            "description": "Omit to release all seats held by the current user in this event",
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": ["event_id"]
      },
      "SeatStatusDto": {
        "type": "object",
        "properties": {
          "sold": {
            "description": "Sold seat IDs",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "held": {
            "description": "Active held seat IDs",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["sold", "held", "as_of"]
      },
      "GaItemDto": {
        "type": "object",
        "properties": {
          "ticket_class_id": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": ["ticket_class_id", "quantity"]
      },
      "MerchItemDto": {
        "type": "object",
        "properties": {
          "sku_id": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": ["sku_id", "quantity"]
      },
      "CheckoutDto": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "seat_ids": {
            "maxItems": 1000,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "ga_items": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GaItemDto"
            }
          },
          "merch_items": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MerchItemDto"
            }
          },
          "voucher_code": {
            "type": "string"
          }
        },
        "required": ["event_id", "seat_ids", "ga_items", "merch_items"]
      },
      "CheckoutResponseDto": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "AWAITING_PAYMENT"]
          },
          "ticket_amount_vnd": {
            "type": "number"
          },
          "merch_amount_vnd": {
            "type": "number"
          },
          "total_amount_vnd": {
            "type": "number"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "order_id",
          "status",
          "ticket_amount_vnd",
          "merch_amount_vnd",
          "total_amount_vnd",
          "expires_at"
        ]
      },
      "QueueEventDto": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["event_id"]
      },
      "QueueStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["waiting", "admitted", "not_joined", "disabled"]
          },
          "position": {
            "type": "number",
            "nullable": true,
            "description": "Zero-based ZRANK; null outside queue"
          },
          "estimated_wait_sec": {
            "type": "number",
            "nullable": true,
            "description": "Estimate from rate; capacity may delay admission further"
          },
          "admission_token": {
            "type": "string",
            "description": "HS256 admission JWT; pass in X-Admission-Token"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["status", "position", "estimated_wait_sec"]
      },
      "OrderView": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "format": "uuid"
          },
          "event_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "total_amount_vnd": {
            "type": "number"
          },
          "ticket_amount_vnd": {
            "type": "number"
          },
          "merch_amount_vnd": {
            "type": "number"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "order_id",
          "event_id",
          "status",
          "total_amount_vnd",
          "ticket_amount_vnd",
          "merch_amount_vnd",
          "expires_at",
          "items"
        ]
      }
    }
  }
}
