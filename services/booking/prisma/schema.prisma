// Partial unique indexes và CHECK nằm trong migration SQL (T-201).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output        = "../generated/prisma"
}

model Order {
  id              String              @id @db.Uuid
  /// ref:identity_db, không FK chéo service.
  userId          String              @map("user_id") @db.Uuid
  /// ref:event_db
  eventId         String              @map("event_id") @db.Uuid
  status          String              @db.VarChar
  ticketAmountVnd BigInt              @map("ticket_amount_vnd")
  merchAmountVnd  BigInt              @map("merch_amount_vnd")
  totalAmountVnd  BigInt              @map("total_amount_vnd")
  idempotencyKey  String              @unique(map: "uq_orders_idempotency_key") @map("idempotency_key") @db.VarChar
  expiresAt       DateTime            @map("expires_at") @db.Timestamptz(6)
  version         Int                 @default(0)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items           OrderItem[]
  allocations     SeatAllocation[]
  redemptions     VoucherRedemption[]

  @@index([userId, createdAt(sort: Desc)], map: "ix_orders_user")
  @@map("orders")
}

model OrderItem {
  id           String   @id @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  itemType     String   @map("item_type") @db.VarChar
  /// ref:event_db (seat/class) hoặc merch_db (SKU), không FK chéo service.
  refId        String   @map("ref_id") @db.Uuid
  quantity     Int
  unitPriceVnd BigInt   @map("unit_price_vnd")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "ix_order_items_order")
  @@map("order_items")
}

model SeatAllocation {
  id        String   @id @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  /// ref:event_db
  eventId   String   @map("event_id") @db.Uuid
  /// ref:event_db
  seatId    String   @map("seat_id") @db.Uuid
  state     String   @db.VarChar
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(0)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "ix_seat_allocations_order")
  @@map("seat_allocations")
}

model TicketClassStock {
  /// ref:event_db; khóa tự nhiên theo ERD.
  classId   String   @id @map("class_id") @db.Uuid
  total     Int
  sold      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(0)

  @@map("ticket_class_stock")
}

model EventSnapshot {
  /// ref:event_db; khóa tự nhiên theo ERD.
  eventId        String   @id @map("event_id") @db.Uuid
  /// ref:identity_db
  organizerId    String   @map("organizer_id") @db.Uuid
  status         String   @db.VarChar
  eventVersion   Int      @map("event_version")
  seatMapVersion Int      @map("seat_map_version")
  pricingReady   Boolean  @default(false) @map("pricing_ready")
  ticketClasses  Json     @map("ticket_classes") @db.JsonB
  saleWindow     Json     @map("sale_window") @db.JsonB
  syncedAt       DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("event_snapshots")
}

model SeatPricing {
  /// ref:event_db; khóa kép theo ERD, không FK sang DB khác.
  eventId        String   @map("event_id") @db.Uuid
  seatId         String   @map("seat_id") @db.Uuid
  seatMapVersion Int      @map("seat_map_version")
  ticketClassId  String   @map("ticket_class_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([eventId, seatId])
  @@index([eventId, seatMapVersion], map: "ix_seat_pricing_version")
  @@map("seat_pricing")
}

model Voucher {
  id          String              @id @db.Uuid
  code        String              @unique(map: "uq_vouchers_code") @db.VarChar
  discountPct Int                 @map("discount_pct")
  maxUses     Int                 @map("max_uses")
  expiresAt   DateTime            @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version     Int                 @default(0)
  redemptions VoucherRedemption[]

  @@map("vouchers")
}

model VoucherRedemption {
  voucherId String   @map("voucher_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  /// ref:identity_db
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  voucher   Voucher  @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@id([voucherId, orderId])
  @@index([orderId], map: "ix_voucher_redemptions_order")
  @@map("voucher_redemptions")
}

model IdempotencyKey {
  key         String   @id @db.VarChar
  /// ref:identity_db
  userId      String   @map("user_id") @db.Uuid
  requestHash String   @map("request_hash") @db.VarChar
  response    Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("idempotency_keys")
}

// Giữ đúng cấu trúc SQL dùng chung trong packages/outbox-inbox/sql/outbox_inbox.sql.
// T-303: hàng công việc bền vững cho message đến sớm và projection Redis sau commit.
model OrderSagaWork {
  id        String   @id @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  kind      String   @db.Text
  payload   Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId], map: "ix_order_saga_work_order")
  @@map("order_saga_work")
}

model OutboxEvent {
  id          String    @id @db.Uuid
  topic       String    @db.Text
  messageKey  String    @map("message_key") @db.Text
  eventType   String    @map("event_type") @db.Text
  payload     Json      @db.JsonB
  traceContext Json?    @map("trace_context") @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  @@map("outbox_events")
}

model ProcessedEvent {
  messageId   String   @map("message_id") @db.Uuid
  consumer    String   @db.Text
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([messageId, consumer])
  @@map("processed_events")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
