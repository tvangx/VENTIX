DATABASE_URL=postgresql://event_user:event_dev@localhost:5432/event_db
PORT=3002
NODE_ENV=development
LOG_LEVEL=info
# LOG_FILE_PATH=/var/log/ticketing/event.log
# LOG_FILE_MAX_BYTES=10485760
# LOG_FILE_MAX_FILES=3
REDIS_URL=redis://localhost:16379

# Xác thực JWT (ADR-0004). Chọn MỘT:
#  - AUTH_JWKS_URI: JWKS của identity-service (dùng cho mọi môi trường thật)
#  - AUTH_PUBLIC_KEY_PEM: khóa công khai PEM, CHỈ dev/test (bị cấm khi NODE_ENV=production)
AUTH_ISSUER=https://identity.ticketing.local
AUTH_AUDIENCE=ticketing-api
AUTH_JWKS_URI=http://localhost:3001/.well-known/jwks.json
# AUTH_PUBLIC_KEY_PEM=

# Khóa dùng chung với Booking cho API seat-classes trực tiếp (S-206).
# INTERNAL_API_KEY=

# Chỉ bật OpenTelemetry khi đặt biến này (ví dụ http://localhost:4318)
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Event lifecycle v2 (Outbox relay)
KAFKA_BROKERS=localhost:9092
EVENT_OUTBOX_ENABLED=true

# Kho ảnh banner sự kiện (S-201b/S-605): MinIO qua giao thức S3. Bucket `event-banners` do minio-init tạo.
# Upload vào staging/ (không công khai); confirm xử lý bằng sharp rồi ghi public/events/... (WebP + thumbnail).
# Không có khóa → presign/confirm trả 503 STORAGE_NOT_CONFIGURED.
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=event-banners
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev
# Gốc URL công khai của bucket. Cần policy đọc ẩn danh cho prefix public/ (thuộc infra/) hoặc CDN. Bỏ trống → banner_url = null.
PUBLIC_ASSET_BASE_URL=http://localhost:9000/event-banners
UPLOAD_MAX_BYTES=5242880
UPLOAD_PRESIGN_TTL_SECONDS=300
