DATABASE_URL=postgresql://finance_user:finance_dev@localhost:5432/finance_db
PORT=3009
NODE_ENV=development
LOG_LEVEL=info

# T-402: giả định phát triển 10%, phải xác nhận thuế hiện hành trước báo cáo thật.
VAT_RATE_TICKET=0.10
VAT_RATE_MERCH=0.10
# Chỉ hỗ trợ true; false bị từ chối khi khởi động (quyết định Tuấn).
PRICES_INCLUDE_VAT=true
FINANCE_WORKERS_ENABLED=true
KAFKA_BROKERS=localhost:9092
EVENT_SERVICE_URL=http://localhost:3002
# Điền khóa dùng chung nội bộ, tối thiểu 16 ký tự; không commit khóa thật.
INTERNAL_API_KEY=
FINANCE_POLL_MS=1000

# S-505: mock-only, không gọi MISA/phát hành hóa đơn thuế. Relay AuditRecorded dùng FinanceWorker.
INVOICE_WORKER_ENABLED=false
INVOICE_POLL_MS=1000
INVOICE_MAX_ATTEMPTS=5
INVOICE_TIMEOUT_MS=5000
INVOICE_LEASE_MS=30000
INVOICE_RETRY_BASE_MS=1000
INVOICE_RETRY_MAX_MS=60000

# Xác thực JWT (ADR-0004). Chọn MỘT:
#  - AUTH_JWKS_URI: JWKS của identity-service (dùng cho mọi môi trường thật)
#  - AUTH_PUBLIC_KEY_PEM: khóa công khai PEM, CHỈ dev/test (bị cấm khi NODE_ENV=production)
AUTH_ISSUER=https://identity.ticketing.local
AUTH_AUDIENCE=ticketing-api
AUTH_JWKS_URI=http://localhost:3001/.well-known/jwks.json
# AUTH_PUBLIC_KEY_PEM=

# Chỉ bật OpenTelemetry khi đặt biến này (ví dụ http://localhost:4318)
# OTEL_EXPORTER_OTLP_ENDPOINT=
