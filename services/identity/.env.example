DATABASE_URL=postgresql://identity_user:identity_dev@localhost:5432/identity_db
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Production: khóa RSA >= 2048 bits PKCS8; dùng \\n cho xuống dòng. Không commit khóa thật.
# Dev/test không đặt biến sẽ sinh khóa tạm; restart làm mất phiên cũ và fingerprint idempotency.
# JWT_PRIVATE_KEY_PEM=
# Google Cloud OAuth web client: phải cấu hình cả ID và secret để bật Google.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/v1/auth/google/callback

# Xác thực JWT (ADR-0004). Chọn MỘT:
#  - AUTH_JWKS_URI: JWKS của identity-service (dùng cho mọi môi trường thật)
#  - AUTH_PUBLIC_KEY_PEM: khóa công khai PEM, CHỈ dev/test (bị cấm khi NODE_ENV=production)
AUTH_ISSUER=https://identity.ticketing.local
AUTH_AUDIENCE=ticketing-api
AUTH_JWKS_URI=http://localhost:3001/.well-known/jwks.json
# AUTH_PUBLIC_KEY_PEM=

# Chỉ bật OpenTelemetry khi đặt biến này (ví dụ http://localhost:4318)
# OTEL_EXPORTER_OTLP_ENDPOINT=
