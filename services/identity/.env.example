DATABASE_URL=postgresql://identity_user:identity_dev@localhost:5432/identity_db
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
# LOG_FILE_PATH=/var/log/ticketing/identity.log
# LOG_FILE_MAX_BYTES=10485760
# LOG_FILE_MAX_FILES=3

KYC_ENABLED=false
IDENTITY_OUTBOX_ENABLED=false
KAFKA_BROKERS=localhost:9092
# Generate independent base64 32-byte encryption keys and HMAC pepper locally.
# KYC_REDIS_URL=redis://127.0.0.1:16379
# KYC_ENCRYPTION_KEYS={"local-v1":"<base64-32-byte-key>"}
# KYC_ACTIVE_KEY_ID=local-v1
# KYC_HMAC_PEPPER=<independent-base64-32-byte-key>
KYC_OTP_TTL_SECONDS=300
KYC_OTP_COOLDOWN_SECONDS=60
KYC_OTP_MAX_ATTEMPTS=5
KYC_SMTP_HOST=127.0.0.1
KYC_SMTP_PORT=11025
KYC_SMTP_FROM=identity@ventix.local
KYC_SMTP_SECURE=false
KYC_SMTP_REQUIRE_TLS=false
KYC_TEST_MAILPIT_IMAGE=axllent/mailpit:v1.33.0
# Production requires TLS via secure SMTP or STARTTLS.
# KYC_SMTP_USER=
# KYC_SMTP_PASSWORD=
# INTERNAL_API_KEY=<internal-service-key-at-least-16-characters>
WEB_ORIGIN=http://localhost:5173
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Production: khóa RSA >= 2048 bits PKCS8; dùng \\n cho xuống dòng. Không commit khóa thật.
# Dev/test không đặt biến sẽ sinh khóa tạm; restart làm mất phiên cũ và fingerprint idempotency.
# JWT_PRIVATE_KEY_PEM=
# Google Cloud OAuth web client: phải cấu hình cả ID và secret để bật Google.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/v1/auth/google/callback
# Bootstrap Admin, không có giá trị mặc định. Chạy seed role trước seed:admin.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Dev khớp infra compose; production dùng credentials riêng có quyền bucket organizer-docs.
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=organizer-docs
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev

# Xác thực JWT (ADR-0004). Chọn MỘT:
#  - AUTH_JWKS_URI: JWKS của identity-service (dùng cho mọi môi trường thật)
#  - AUTH_PUBLIC_KEY_PEM: khóa công khai PEM, CHỈ dev/test (bị cấm khi NODE_ENV=production)
AUTH_ISSUER=https://identity.ticketing.local
AUTH_AUDIENCE=ticketing-api
AUTH_JWKS_URI=http://localhost:3001/.well-known/jwks.json
# AUTH_PUBLIC_KEY_PEM=

# Chỉ bật OpenTelemetry khi đặt biến này (ví dụ http://localhost:4318)
# OTEL_EXPORTER_OTLP_ENDPOINT=
