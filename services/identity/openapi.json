  "info": {
    "title": "identity service",
    "description": "Identity tuần 1: email/Google auth, HttpOnly refresh cookie, RBAC/tenant và duyệt Organizer. Refresh cần credentials/include; access token chỉ giữ trong bộ nhớ.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/",
      "description": "Direct service"
    },
    {
      "url": "/api/identity",
      "description": "Kong gateway"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ventix_refresh"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": ["status"]
      },
      "WhoamiResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "roles": {
            "example": ["USER"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "organizerId": {
            "type": "string"
          }
        },
        "required": ["userId", "roles"]
      },
      "CredentialsDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "son@example.test",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": ["email", "password"]
      },
      "RegisteredUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "son@example.test"
          }
        },
        "required": ["id", "email"]
      },
      "AccessTokenDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "expires_in": {
            "type": "number",
            "example": 900
          }
        },
        "required": ["access_token", "token_type", "expires_in"]
      },
      "RsaJwkDto": {
        "type": "object",
        "properties": {
          "kty": {
            "type": "string",
            "example": "RSA"
          },
          "kid": {
            "type": "string"
          },
          "alg": {
            "type": "string",
            "example": "RS256"
          },
          "use": {
            "type": "string",
            "example": "sig"
          },
          "n": {
            "type": "string"
          },
          "e": {
            "type": "string"
          }
        },
        "required": ["kty", "kid", "alg", "use", "n", "e"]
      },
      "JwksDto": {
        "type": "object",
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RsaJwkDto"
            }
          }
        },
        "required": ["keys"]
      },
      "GoogleStartDto": {
        "type": "object",
        "properties": {
          "authorization_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["authorization_url"]
      },
      "MembershipDto": {
        "type": "object",
        "properties": {
          "organizer_id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": ["ORGANIZER", "STAFF"]
          }
        },
        "required": ["organizer_id", "role"]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MembershipDto"
            }
          }
        },
        "required": ["id", "email", "roles", "memberships"]
      },
      "TenantContextDto": {
        "type": "object",
        "properties": {
          "organizer_id": {
            "type": "string",
            "format": "uuid"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["organizer_id", "roles"]
      },
      "OrganizerApplicationDto": {
        "type": "object",
        "properties": {
          "company_name": {
            "type": "string",
            "maxLength": 255
          },
          "tax_code": {
            "type": "string",
            "maxLength": 32
          }
        },
        "required": ["company_name"]
      },
      "ApplicationResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "owner_user_id": {
            "type": "string",
            "format": "uuid"
          },
          "company_name": {
            "type": "string"
          },
          "tax_code": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "APPROVED", "REJECTED"]
          },
          "version": {
            "type": "number",
            "minimum": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "approved_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "owner_user_id",
          "company_name",
          "tax_code",
          "status",
          "version",
          "created_at",
          "approved_at"
        ]
      },
      "DocumentResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "doc_type": {
            "type": "string",
            "enum": ["BUSINESS_LICENSE"]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "doc_type", "created_at"]
      },
      "ApplicationDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "owner_user_id": {
            "type": "string",
            "format": "uuid"
          },
          "company_name": {
            "type": "string"
          },
          "tax_code": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "APPROVED", "REJECTED"]
          },
          "version": {
            "type": "number",
            "minimum": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "approved_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentResponseDto"
            }
          }
        },
        "required": [
          "id",
          "owner_user_id",
          "company_name",
          "tax_code",
          "status",
          "version",
          "created_at",
          "approved_at",
          "documents"
        ]
      },
      "DocumentDownloadDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "expires_in": {
            "type": "number",
            "example": 60
          }
        },
        "required": ["url", "expires_in"]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "ApplicationListDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApplicationResponseDto"
            }
          },
          "next_cursor": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": ["data", "next_cursor"]
      },
      "OrganizerDecisionDto": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": ["APPROVED", "REJECTED"]
          },
          "version": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": ["decision", "version"]
      },
      "KycStatus": {
        "type": "object",
        "properties": {
          "verified": {
            "type": "boolean"
          },
          "kycHash": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["verified", "kycHash"]
      },
      "KycChallengeRequest": {
        "type": "object",
        "properties": {
          "id_number": {
            "type": "string",
            "pattern": "^[0-9]{12}$"
          },
          "full_name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          }
        },
        "required": ["id_number", "full_name"]
      },
      "KycChallengeResponse": {
        "type": "object",
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["challenge_id", "expires_at"]
      },
      "KycVerifyRequest": {
        "type": "object",
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          }
        },
        "required": ["challenge_id", "code"]
      },
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status", "detail", "code", "request_id"],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "INVALID_REFRESH_TOKEN"
          },
          "request_id": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
