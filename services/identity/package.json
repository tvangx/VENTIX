{
  "name": "@ticketing/identity",
  "version": "0.1.0",
  "private": true,
  "description": "identity service",
  "main": "dist/main.js",
  "files": [
    "dist",
    "prisma",
    "scripts"
  ],
  "scripts": {
    "dev": "nest start --watch",
    "build": "node scripts/prisma-generate.js && nest build",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "node scripts/prisma-generate.js && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/prisma-generate.js && jest",
    "test:int": "node scripts/prisma-generate.js && jest --config jest.int.config.js --runInBand",
    "test:storage": "node scripts/prisma-generate.js && jest --config jest.storage.config.js --runInBand",
    "test:conc": "node scripts/prisma-generate.js && jest --config jest.conc.config.js --runInBand --passWithNoTests",
    "openapi:export": "pnpm build && node dist/tools/export-openapi.js && prettier --write openapi.json",
    "prisma:migrate:create": "prisma migrate dev --create-only",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "seed": "node prisma/seed.js",
    "seed:admin": "pnpm build && node dist/tools/seed-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@nestjs/common": "^10.4.7",
    "@nestjs/core": "^10.4.7",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/swagger": "^8.0.7",
    "@opentelemetry/exporter-trace-otlp-http": "^0.54.0",
    "@opentelemetry/instrumentation-express": "^0.44.0",
    "@opentelemetry/instrumentation-http": "^0.54.0",
    "@opentelemetry/sdk-node": "^0.54.0",
    "@prisma/client": "^5.22.0",
    "@ticketing/auth-guard": "workspace:*",
    "@ticketing/common": "workspace:*",
    "@ticketing/event-contracts": "workspace:*",
    "@ticketing/outbox-inbox": "workspace:*",
    "argon2": "0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "helmet": "^8.0.0",
    "ioredis": "5.11.1",
    "jose": "^5.10.0",
    "kafkajs": "^2.2.4",
    "multer": "2.5.0",
    "nodemailer": "10.5.0",
    "pg": "^8.13.1",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.7",
    "@nestjs/testing": "^10.4.7",
    "@testcontainers/postgresql": "^10.13.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "2.3.0",
    "@types/node": "^20.16.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.13.2",
    "ts-jest": "^29.2.5"
  }
}
