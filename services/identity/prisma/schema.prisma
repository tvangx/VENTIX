generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id                 String             @id @default(uuid()) @db.Uuid
  email              String             @unique @db.VarChar(254)
  phone              String?            @db.VarChar(32)
  passwordHash       String?            @map("password_hash") @db.VarChar(255)
  status             String             @default("ACTIVE") @db.VarChar(24)
  emailVerifiedAt    DateTime?          @map("email_verified_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int                @default(0)
  oauthAccounts      OauthAccount[]
  refreshTokens      RefreshToken[]
  userRoles          UserRole[]
  kycProfile         KycProfile?
  organizers         Organizer[]        @relation("OrganizerOwner")
  approvedOrganizers Organizer[]        @relation("OrganizerApprover")
  googleStates       GoogleOauthState[]

  @@map("users")
}

model OauthAccount {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  provider    String   @db.VarChar(32)
  providerUid String   @map("provider_uid") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerUid])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([familyId])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Role {
  id        Int        @id @db.SmallInt
  code      String     @unique @db.VarChar(24)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId      String     @map("user_id") @db.Uuid
  roleId      Int        @map("role_id") @db.SmallInt
  organizerId String?    @map("organizer_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  role        Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organizer   Organizer? @relation(fields: [organizerId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([organizerId])
  @@map("user_roles")
}

model KycProfile {
  userId       String    @id @map("user_id") @db.Uuid
  idNumberEnc  Bytes     @map("id_number_enc")
  idNumberHmac String    @unique @map("id_number_hmac") @db.VarChar(64)
  fullNameEnc  Bytes     @map("full_name_enc")
  keyId        String    @map("key_id") @db.VarChar(128)
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version      Int       @default(0)
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("kyc_profiles")
}

model Organizer {
  id          String              @id @default(uuid()) @db.Uuid
  ownerUserId String              @map("owner_user_id") @db.Uuid
  companyName String              @map("company_name") @db.VarChar(255)
  taxCode     String?             @map("tax_code") @db.VarChar(32)
  status      String              @default("PENDING") @db.VarChar(24)
  approvedBy  String?             @map("approved_by") @db.Uuid
  approvedAt  DateTime?           @map("approved_at") @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  version     Int                 @default(0)
  owner       User                @relation("OrganizerOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  approver    User?               @relation("OrganizerApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  documents   OrganizerDocument[]
  userRoles   UserRole[]

  @@index([ownerUserId])
  @@index([status, createdAt, id])
  @@map("organizers")
}

model OrganizerDocument {
  id          String    @id @default(uuid()) @db.Uuid
  organizerId String    @map("organizer_id") @db.Uuid
  docType     String    @map("doc_type") @db.VarChar(64)
  objectKey   String    @unique @map("object_key") @db.VarChar(512)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)

  @@index([organizerId])
  @@map("organizer_documents")
}

model OutboxEvent {
  id          String    @id @db.Uuid
  topic       String
  messageKey  String    @map("message_key")
  eventType   String    @map("event_type")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  @@map("outbox_events")
}

model ProcessedEvent {
  messageId   String   @map("message_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([messageId, consumer])
  @@map("processed_events")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  scope       String   @db.VarChar(128)
  key         String   @db.Uuid
  requestHash String   @map("request_hash") @db.VarChar(64)
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([scope, key])
  @@map("idempotency_keys")
}

model GoogleOauthState {
  id         String    @id @default(uuid()) @db.Uuid
  stateHash  String    @unique @map("state_hash") @db.VarChar(64)
  cookieHash String    @map("cookie_hash") @db.VarChar(64)
  linkUserId String?   @map("link_user_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  linkUser   User?     @relation(fields: [linkUserId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@map("google_oauth_states")
}
