DATABASE_URL=postgresql://payment_user:payment_dev@localhost:5432/payment_db
PORT=3004
NODE_ENV=development
LOG_LEVEL=info

# Xác thực JWT (ADR-0004). Chọn MỘT:
#  - AUTH_JWKS_URI: JWKS của identity-service (dùng cho mọi môi trường thật)
#  - AUTH_PUBLIC_KEY_PEM: khóa công khai PEM, CHỈ dev/test (bị cấm khi NODE_ENV=production)
AUTH_ISSUER=https://identity.ticketing.local
AUTH_AUDIENCE=ticketing-api
AUTH_JWKS_URI=http://localhost:3001/.well-known/jwks.json
# AUTH_PUBLIC_KEY_PEM=

# Chỉ bật OpenTelemetry khi đặt biến này (ví dụ http://localhost:4318)
# OTEL_EXPORTER_OTLP_ENDPOINT=

# T-302 payment adapters. Secret values are intentionally empty.
KAFKA_BROKERS=localhost:9092
PAYMENT_WORKERS_ENABLED=true
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
VNPAY_IPN_URL=
# MOCK_DELAY_MS is the minimum; the maximum is inclusive.
MOCK_DELAY_MS=1000
MOCK_MAX_DELAY_MS=3000
MOCK_SUCCESS_RATE=0.95
MOCK_OUTCOME=RANDOM
MOCK_DUPLICATE_IPN=false
