DATABASE_URL=postgresql://payment_user:payment_dev@localhost:5432/payment_db
PORT=3004
NODE_ENV=development
LOG_LEVEL=info

# Xác thực JWT (ADR-0004). Chọn MỘT:
#  - AUTH_JWKS_URI: JWKS của identity-service (dùng cho mọi môi trường thật)
#  - AUTH_PUBLIC_KEY_PEM: khóa công khai PEM, CHỈ dev/test (bị cấm khi NODE_ENV=production)
AUTH_ISSUER=https://identity.ticketing.local
AUTH_AUDIENCE=ticketing-api
AUTH_JWKS_URI=http://localhost:3001/.well-known/jwks.json
# AUTH_PUBLIC_KEY_PEM=

# Chỉ bật OpenTelemetry khi đặt biến này (ví dụ http://localhost:4318)
# OTEL_EXPORTER_OTLP_ENDPOINT=

# T-302 payment adapters. Secret values are intentionally empty.
KAFKA_BROKERS=localhost:9092
PAYMENT_WORKERS_ENABLED=true
VNPAY_ENABLED=false
VNPAY_PAYMENT_URL=https://sandbox.vnpaytest.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
VNPAY_IPN_URL=

# T-401: endpoint tham chiếu; phải xác minh quyền/endpoint merchant trước khi bật EC2.
VNPAY_REFUND_ENABLED=false
VNPAY_REFUND_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_REFUND_IP=127.0.0.1
VNPAY_REFUND_TIMEOUT_MS=10000
REFUND_CONCURRENCY=5
REFUND_RATE_PER_SEC=5
REFUND_MAX_ATTEMPTS=5
REFUND_LEASE_MS=30000
REFUND_BACKOFF_MS=1000
REFUND_BACKOFF_MAX_MS=60000
MOCK_REFUND_FAILURE_RATE=0
MOCK_REFUND_OUTCOME=SUCCESS
# MOCK_DELAY_MS is the minimum; the maximum is inclusive.
MOCK_DELAY_MS=1000
MOCK_MAX_DELAY_MS=3000
MOCK_SUCCESS_RATE=0.95
MOCK_OUTCOME=RANDOM
MOCK_DUPLICATE_IPN=false

# T-405: optional config for dev:publish-fake-resale-order only (validated by script).
# Set in the shell; the script does not automatically load .env.
# FAKE_RESALE_ORDER_ID=11111111-1111-4111-8111-111111111111
# FAKE_LISTING_ID=22222222-2222-4222-8222-222222222222
# FAKE_BUYER_ID=33333333-3333-4333-8333-333333333333
# FAKE_EVENT_ID=44444444-4444-4444-8444-444444444444
# FAKE_AMOUNT_VND=125000
# FAKE_EXPIRES_IN_SECONDS=900
