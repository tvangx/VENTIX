{
  "openapi": "3.0.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "summary": "Process is up",
        "tags": ["health"]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable (problem+json, code NOT_READY)"
          }
        },
        "summary": "Ready to serve traffic (checks the database)",
        "tags": ["health"]
      }
    },
    "/v1/whoami": {
      "get": {
        "operationId": "WhoamiController_whoami",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoamiResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token (problem+json)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Return the authenticated principal",
        "tags": ["whoami"]
      }
    },
    "/v1/payments": {
      "post": {
        "operationId": "PaymentController_create",
        "parameters": [
          {
            "name": "idempotency-key",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body or Idempotency-Key"
          },
          "401": {
            "description": "JWT required"
          },
          "403": {
            "description": "PAYMENT_FORBIDDEN"
          },
          "409": {
            "description": "ORDER_NOT_READY, PAYABLE_EXPIRED, PAYMENT_ALREADY_ACTIVE",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "example": 1
                }
              }
            }
          },
          "422": {
            "description": "IDEMPOTENCY_KEY_REUSED, INVALID_PAYMENT_AMOUNT"
          },
          "503": {
            "description": "PROVIDER_UNAVAILABLE"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create or replay a payment link for an owned payable order",
        "tags": ["payments"]
      }
    },
