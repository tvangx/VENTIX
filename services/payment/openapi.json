          },
          "404": {
            "description": "Refund or batch not found"
          },
          "409": {
            "description": "Payment not refundable, snapshot not ready or invalid refund state"
          },
          "422": {
            "description": "Idempotency-Key reused for a different request"
          }
        },
        "security": [
          {
            "bearer": []
