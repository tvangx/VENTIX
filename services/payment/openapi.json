  },
  "info": {
    "title": "payment service",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": ["status"]
      },
      "WhoamiResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "roles": {
            "example": ["USER"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "organizerId": {
            "type": "string"
          }
        },
        "required": ["userId", "roles"]
      },
      "PaymentDto": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "format": "uuid"
          },
          "provider": {
            "type": "string",
            "enum": ["VNPAY", "MOCK"]
          }
        },
        "required": ["order_id", "provider"]
      },
      "PaymentResponse": {
        "type": "object",
        "properties": {
          "redirect_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["redirect_url"]
      },
      "IpnResponse": {
        "type": "object",
        "properties": {
          "RspCode": {
            "type": "string",
            "enum": ["97", "99", "00", "01", "02", "04"]
          },
          "Message": {
            "type": "string"
          }
        },
        "required": ["RspCode", "Message"]
      },
      "ReturnResponse": {
        "type": "object",
        "properties": {
          "signature_valid": {
            "type": "boolean"
          },
          "provider_succeeded": {
            "type": "boolean"
          }
        },
        "required": ["signature_valid", "provider_succeeded"]
      }
    }
  }
}
