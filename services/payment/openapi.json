          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "payment_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "batch_id": {
                      "type": "string",
                      "nullable": true
                    },
                    "amount_vnd": {
                      "type": "string",
                      "description": "Integer VND"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": ["PENDING", "PROCESSING", "SUCCEEDED", "NEEDS_MANUAL"]
                    },
                    "attempts": {
                      "type": "integer"
                    },
                    "next_attempt_at": {
                      "type": "string",
                      "nullable": true
                    },
                    "last_error": {
                      "type": "string",
                      "nullable": true
                    },
                    "provider_refund_id": {
                      "type": "string",
                      "nullable": true
                    },
                    "created_at": {
                      "type": "string"
                    },
                    "updated_at": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or Idempotency-Key"
          },
          "401": {
            "description": "JWT required"
          },
          "403": {
            "description": "ADMIN role and tenant scope required"
          },
          "404": {
            "description": "Refund or batch not found"
          },
          "409": {
            "description": "Payment not refundable, snapshot not ready or invalid refund state"
          },
          "422": {
            "description": "Idempotency-Key reused for a different request"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Request full refund for a succeeded ORDER payment",
        "tags": ["admin-refunds"]
      },
