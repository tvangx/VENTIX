    "/v1/payments": {
      "post": {
        "operationId": "PaymentController_create",
        "parameters": [
          {
            "name": "idempotency-key",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/PaymentDto"
                  },
                  {
                    "oneOf": [
                      {
                        "required": ["order_id"]
                      },
                      {
                        "required": ["resale_order_id"]
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body or Idempotency-Key"
          },
          "401": {
            "description": "JWT required"
          },
          "403": {
            "description": "PAYMENT_FORBIDDEN"
          },
          "409": {
            "description": "ORDER_NOT_READY, PAYABLE_EXPIRED, PAYMENT_ALREADY_ACTIVE",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "example": 1
                }
              }
            }
          },
          "422": {
            "description": "INVALID_PAYMENT_REFERENCE, IDEMPOTENCY_KEY_REUSED, INVALID_PAYMENT_AMOUNT"
          },
          "503": {
            "description": "PROVIDER_UNAVAILABLE"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create or replay a payment link for an owned payable order",
        "tags": ["payments"]
      }
    },
