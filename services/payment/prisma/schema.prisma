generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Payable {
  id        String   @unique @db.Uuid
  purpose   String   @db.VarChar
  refId     String   @map("ref_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  amountVnd BigInt   @map("amount_vnd")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  status    String   @default("READY") @db.VarChar
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(0)

  @@id([purpose, refId])
  @@map("payables")
}

model Payment {
  id             String               @id @db.Uuid
  purpose        String               @db.VarChar
  refId          String               @map("ref_id") @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  eventId        String               @map("event_id") @db.Uuid
  provider       String               @db.VarChar
  amountVnd      BigInt               @map("amount_vnd")
  status         String               @default("PENDING") @db.VarChar
  idempotencyKey String               @unique @map("idempotency_key") @db.VarChar(200)
  requestHash    String               @map("request_hash") @db.VarChar(64)
  redirectUrl    String               @map("redirect_url") @db.Text
  expiresAt      DateTime             @map("expires_at") @db.Timestamptz(6)
  paidAt         DateTime?            @map("paid_at") @db.Timestamptz(6)
  traceId        String               @map("trace_id") @db.VarChar
  mockData       Json?                @map("mock_data") @db.JsonB
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  version        Int                  @default(0)
  transactions   PaymentTransaction[]
  refunds        Refund[]

  @@map("payments")
}

model PaymentTransaction {
  id             String   @id @db.Uuid
  paymentId      String   @map("payment_id") @db.Uuid
  providerTxnId  String   @unique @map("provider_txn_id") @db.VarChar
  kind           String   @db.VarChar
  signatureValid Boolean  @map("signature_valid")
  rawPayload     Json     @map("raw_payload") @db.JsonB
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@map("payment_transactions")
}

model RefundBatch {
  id        String   @id @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  reason    String   @db.VarChar
  status    String   @db.VarChar
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(0)
  refunds   Refund[]

  @@map("refund_batches")
}

model Refund {
  id               String       @id @db.Uuid
  paymentId        String       @unique @map("payment_id") @db.Uuid
  batchId          String?      @map("batch_id") @db.Uuid
  amountVnd        BigInt       @map("amount_vnd")
  reason           String       @db.VarChar
  status           String       @default("PENDING") @db.VarChar
  attempts         Int          @default(0)
  nextAttemptAt    DateTime?    @map("next_attempt_at") @db.Timestamptz(6)
  providerRefundId String?      @map("provider_refund_id") @db.VarChar
  lastError        String?      @map("last_error") @db.Text
  approvedBy       String?      @map("approved_by") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  version          Int          @default(0)
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  batch            RefundBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@map("refunds")
}

model ReconciliationRun {
  id         String   @id @db.Uuid
  runAt      DateTime @map("run_at") @db.Timestamptz(6)
  matched    Int
  mismatched Int
  details    Json     @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("reconciliation_runs")
}

model OutboxEvent {
  id          String    @id @db.Uuid
  topic       String    @db.Text
  messageKey  String    @map("message_key") @db.Text
  eventType   String    @map("event_type") @db.Text
  payload     Json      @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  @@map("outbox_events")
}

model ProcessedEvent {
  messageId   String   @map("message_id") @db.Uuid
  consumer    String   @db.Text
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([messageId, consumer])
  @@map("processed_events")
}
