{
  "openapi": "3.0.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "summary": "Process is up",
        "tags": ["health"]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable (problem+json, code NOT_READY)"
          }
        },
        "summary": "Ready to serve traffic (checks the database)",
        "tags": ["health"]
      }
    },
    "/v1/whoami": {
      "get": {
        "operationId": "WhoamiController_whoami",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoamiResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token (problem+json)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Return the authenticated principal",
        "tags": ["whoami"]
      }
    },
    "/v1/listings/me": {
      "get": {
        "operationId": "ListingController_list",
        "parameters": [
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListingPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "JWT required"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List current seller listings",
        "tags": ["listings"]
      }
    },
    "/v1/listings/quote": {
      "post": {
        "operationId": "ListingController_quote",
        "parameters": [
          {
            "name": "authorization",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "JWT required"
          },
          "404": {
            "description": "Ticket not owned or absent"
          },
          "409": {
            "description": "Ticket is not ACTIVE"
          },
          "422": {
            "description": "Resale price exceeds cap"
          },
          "503": {
            "description": "Ticket service unavailable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Validate a resale price using the owned ticket's server price",
        "tags": ["listings"]
      }
    }
  },
  "info": {
    "title": "resale service",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": ["status"]
      },
      "WhoamiResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "roles": {
            "example": ["USER"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "organizerId": {
            "type": "string"
          }
        },
        "required": ["userId", "roles"]
      },
      "ListingView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ticket_id": {
            "type": "string",
            "format": "uuid"
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "original_price_vnd": {
            "type": "string"
          },
          "ask_price_vnd": {
            "type": "string"
          },
          "max_percent": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "SOLD", "CANCELLED", "EXPIRED"]
          },
          "version": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "ticket_id",
          "event_id",
          "original_price_vnd",
          "ask_price_vnd",
          "max_percent",
          "status",
          "version"
        ]
      },
      "ListingPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ListingView"
            }
          },
          "next_cursor": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": ["items", "next_cursor"]
      },
      "QuoteRequest": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "string",
            "format": "uuid"
          },
          "ask_price_vnd": {
            "type": "number",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["ticket_id", "ask_price_vnd"]
      },
      "QuoteResponse": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "string",
            "format": "uuid"
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "original_price_vnd": {
            "type": "string",
            "example": "100000"
          },
          "ask_price_vnd": {
            "type": "string",
            "example": "120000"
          },
          "maximum_price_vnd": {
            "type": "string",
            "example": "120000"
          },
          "max_percent": {
            "type": "number",
            "example": 120
          }
        },
        "required": [
          "ticket_id",
          "event_id",
          "original_price_vnd",
          "ask_price_vnd",
          "maximum_price_vnd",
          "max_percent"
        ]
      }
    }
  }
}
