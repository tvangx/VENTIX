generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Listing {
  id               String   @id @db.Uuid
  ticketId         String   @map("ticket_id") @db.Uuid
  sellerId         String   @map("seller_id") @db.Uuid
  eventId          String   @map("event_id") @db.Uuid
  originalPriceVnd BigInt   @map("original_price_vnd")
  askPriceVnd      BigInt   @map("ask_price_vnd")
  maxPercent       Int      @default(120) @map("max_percent")
  status           String
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@index([sellerId, id])
  @@map("listings")
}

model PriceCapRule {
  eventId    String   @id @map("event_id") @db.Uuid
  maxPercent Int      @default(120) @map("max_percent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz
  version    Int      @default(1)

  @@map("price_cap_rules")
}

model OutboxEvent {
  id          String    @id @db.Uuid
  topic       String
  messageKey  String    @map("message_key")
  eventType   String    @map("event_type")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  publishedAt DateTime? @map("published_at") @db.Timestamptz

  @@map("outbox_events")
}

model ProcessedEvent {
  messageId   String   @map("message_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@id([messageId, consumer])
  @@map("processed_events")
}
