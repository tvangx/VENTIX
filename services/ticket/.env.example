DATABASE_URL=postgresql://ticket_user:ticket_dev@localhost:5432/ticket_db
PORT=3005
NODE_ENV=development
LOG_LEVEL=info

TICKET_WORKERS_ENABLED=false
TICKET_PACKAGE_TTL_SECONDS=600
TICKET_PACKAGE_MAX_TICKETS=10000
KAFKA_BROKERS=localhost:9092
# Generate keys locally; never commit a real key. Enabling the worker requires both variables.
# TICKET_ENCRYPTION_KEYS={"local-v1":"<base64-encoded-32-byte-key>"}
# TICKET_ACTIVE_KEY_ID=local-v1

# Xác thực JWT (ADR-0004). Chọn MỘT:
#  - AUTH_JWKS_URI: JWKS của identity-service (dùng cho mọi môi trường thật)
#  - AUTH_PUBLIC_KEY_PEM: khóa công khai PEM, CHỈ dev/test (bị cấm khi NODE_ENV=production)
AUTH_ISSUER=https://identity.ticketing.local
AUTH_AUDIENCE=ticketing-api
AUTH_JWKS_URI=http://localhost:3001/.well-known/jwks.json
# AUTH_PUBLIC_KEY_PEM=

# Chỉ bật OpenTelemetry khi đặt biến này (ví dụ http://localhost:4318)
# OTEL_EXPORTER_OTLP_ENDPOINT=
