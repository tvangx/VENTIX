{
  "openapi": "3.0.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "summary": "Process is up",
        "tags": ["health"]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable (problem+json, code NOT_READY)"
          }
        },
        "summary": "Ready to serve traffic (checks the database)",
        "tags": ["health"]
      }
    },
    "/v1/whoami": {
      "get": {
        "operationId": "WhoamiController_whoami",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoamiResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token (problem+json)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Return the authenticated principal",
        "tags": ["whoami"]
      }
    },
    "/v1/public/tickets/{ticketId}": {
      "get": {
        "operationId": "VerifyController_lookup",
        "parameters": [
          {
            "name": "ticketId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicTicketDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid UUID (problem+json)"
          },
          "404": {
            "description": "Ticket not found (problem+json)"
          },
          "429": {
            "description": "Rate limited; Retry-After header (problem+json)"
          }
        },
        "summary": "Read public ticket state without owner or secret data",
        "tags": ["public-verification"]
      }
    },
    "/v1/verify": {
      "get": {
        "operationId": "VerifyController_page",
        "parameters": [
          {
            "name": "ticket_id",
            "required": false,
            "in": "query",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML form and optional lookup result",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "HTML form with invalid ticket ID error"
          },
          "404": {
            "description": "HTML form with ticket not found error"
          },
          "429": {
            "description": "Rate limited (problem+json)"
          }
        },
        "summary": "Public server-rendered ticket verification form",
        "tags": ["public-verification"]
      }
    }
  },
  "info": {
    "title": "ticket service",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": ["status"]
      },
      "WhoamiResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "roles": {
            "example": ["USER"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "organizerId": {
            "type": "string"
          }
        },
        "required": ["userId", "roles"]
      },
      "PublicNftDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["NOT_REQUESTED", "PENDING", "MINTING", "MINTED", "FAILED"]
          },
          "provider": {
            "type": "string",
            "nullable": true,
            "enum": ["MOCK"]
          },
          "token_id": {
            "type": "string",
            "nullable": true
          },
          "tx_hash": {
            "type": "string",
            "nullable": true,
            "description": "NULL for MOCK. No on-chain transaction is fabricated."
          }
        },
        "required": ["status", "provider", "token_id", "tx_hash"]
      },
      "PublicTicketDto": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "FROZEN", "CHECKED_IN", "REVOKED", "REFUNDED"]
          },
          "active": {
            "type": "boolean",
            "description": "True only for ACTIVE; does not prove ownership or replace TOTP check-in."
          },
          "nft": {
            "$ref": "#/components/schemas/PublicNftDto"
          }
        },
        "required": ["ticket_id", "status", "active", "nft"]
      }
    }
  }
}
