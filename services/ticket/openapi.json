  "info": {
    "title": "ticket service",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": ["status"]
      },
      "WhoamiResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "roles": {
            "example": ["USER"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "organizerId": {
            "type": "string"
          }
        },
        "required": ["userId", "roles"]
      },
      "TicketView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "order_id": {
            "type": "string",
            "format": "uuid"
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "seat_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "item_type": {
            "type": "string",
            "enum": ["TICKET_SEAT", "TICKET_GA"]
          },
          "ref_id": {
            "type": "string",
            "format": "uuid"
          },
          "unit_price_vnd": {
            "type": "string",
            "example": "100000",
            "description": "Integer VND as a decimal string"
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "FROZEN", "CHECKED_IN", "REVOKED", "REFUNDED"]
          },
          "secret_version": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "order_id",
          "event_id",
          "seat_id",
          "item_type",
          "ref_id",
          "unit_price_vnd",
          "status",
          "secret_version"
        ]
      },
      "TicketPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TicketView"
            }
          },
          "next_cursor": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": ["items", "next_cursor"]
      },
      "TicketToken": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "string",
            "format": "uuid"
          },
          "secret_version": {
            "type": "number"
          },
          "token": {
            "type": "string",
            "example": "012345"
          },
          "step_seconds": {
            "type": "number",
            "example": 30
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "qr_payload": {
            "type": "string",
            "description": "JSON QR v1 containing version, ticket_id, secret_version, token"
          }
        },
        "required": [
          "ticket_id",
          "secret_version",
          "token",
          "step_seconds",
          "server_time",
          "expires_at",
          "qr_payload"
        ]
      },
      "CreateGate": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": ["event_id", "name"]
      },
      "GateView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "event_id", "name"]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "GatePage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GateView"
            }
          },
          "next_cursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["items", "next_cursor"]
      },
      "AssignStaff": {
        "type": "object",
        "properties": {
          "staff_user_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["staff_user_id"]
      },
      "AssignmentView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "gate_id": {
            "type": "string",
            "format": "uuid"
          },
          "staff_user_id": {
            "type": "string",
            "format": "uuid"
          },
          "revoked_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": ["id", "gate_id", "staff_user_id", "revoked_at"]
      },
      "AssignTickets": {
        "type": "object",
        "properties": {
          "ticket_ids": {
            "minItems": 1,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["ticket_ids"]
      },
      "TicketAssignmentView": {
        "type": "object",
        "properties": {
          "gate_id": {
            "type": "string",
            "format": "uuid"
          },
          "assigned_count": {
            "type": "number"
          }
        },
        "required": ["gate_id", "assigned_count"]
      },
      "CreateVerificationPackage": {
        "type": "object",
        "properties": {
          "public_key_pem": {
            "type": "string",
            "description": "Device RSA SPKI public key in PEM, 2048–4096 bits",
            "maxLength": 1500
          }
        },
        "required": ["public_key_pem"]
      },
      "VerificationPackage": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": ["ticket-verification-v1"]
          },
          "algorithm": {
            "type": "string",
            "enum": ["RSA-OAEP-256+A256GCM"]
          },
          "package_id": {
            "type": "string",
            "format": "uuid"
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "gate_id": {
            "type": "string",
            "format": "uuid"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "encrypted_key": {
            "type": "string",
            "description": "Base64 RSA-OAEP SHA-256 encrypted AES key"
          },
          "nonce": {
            "type": "string",
            "description": "Base64 12-byte AES-GCM nonce"
          },
          "aad": {
            "type": "string",
            "description": "Base64 UTF-8 JSON metadata array authenticated by GCM"
          },
          "ciphertext": {
            "type": "string",
            "description": "Base64 AES-GCM ciphertext followed by 16-byte authentication tag"
          }
        },
        "required": [
          "format",
          "algorithm",
          "package_id",
          "event_id",
          "gate_id",
          "issued_at",
          "expires_at",
          "encrypted_key",
          "nonce",
          "aad",
          "ciphertext"
        ]
      }
    }
  }
}
