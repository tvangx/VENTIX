      }
    },
    "/v1/tickets": {
      "get": {
        "operationId": "TicketController_list",
        "parameters": [
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid UUID or pagination parameters"
          },
          "401": {
            "description": "JWT required"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List the authenticated user's tickets",
        "tags": ["tickets"]
      }
    },
    "/v1/tickets/{ticketId}/token": {
      "get": {
        "operationId": "TicketController_token",
        "parameters": [
          {
            "name": "ticketId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketToken"
                }
              }
            }
          },
          "400": {
            "description": "Invalid UUID or pagination parameters"
          },
          "401": {
            "description": "JWT required"
          },
          "404": {
            "description": "Ticket absent or owned by another user"
          },
          "409": {
            "description": "Ticket is not ACTIVE"
          },
          "503": {
            "description": "Current ticket secret unavailable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get a current TOTP and QR payload for an owned active ticket",
        "tags": ["tickets"]
      }
    },
    "/v1/gates": {
      "post": {
        "operationId": "GateController_create",
        "parameters": [
          {
            "name": "idempotency-key",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateView"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing UUID Idempotency-Key"
          },
          "401": {
            "description": "JWT required"
          },
          "403": {
            "description": "Role, tenant or gate assignment denied"
          },
          "404": {
            "description": "Gate unavailable"
          },
          "409": {
            "description": "Event unavailable, assignment conflict, expired package or request key reused"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create a gate for an event in the authenticated organizer tenant",
        "tags": ["gates"]
      }
    },
