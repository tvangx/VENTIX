generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TicketOrderInvalidation {
  orderId   String   @id @map("order_id") @db.Uuid
  status    String
  eventId   String?  @map("event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  version   Int      @default(1)

  @@map("ticket_order_invalidations")
}

model TicketIssuance {
  orderId     String   @id @map("order_id") @db.Uuid
  fingerprint String   @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  tickets     Ticket[]

  @@map("ticket_issuances")
}

model Ticket {
  id            String         @id @db.Uuid
  orderId       String         @map("order_id") @db.Uuid
  orderItemId   String         @map("order_item_id") @db.Uuid
  unitIndex     Int            @map("unit_index")
  eventId       String         @map("event_id") @db.Uuid
  organizerId   String?        @map("organizer_id") @db.Uuid
  itemType      String         @map("item_type")
  refId         String         @map("ref_id") @db.Uuid
  seatId        String?        @map("seat_id") @db.Uuid
  ownerUserId   String         @map("owner_user_id") @db.Uuid
  unitPriceVnd  BigInt         @map("unit_price_vnd")
  status        String         @default("ACTIVE")
  secretVersion Int            @default(1) @map("secret_version")
  version       Int            @default(1)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @default(now()) @map("updated_at") @db.Timestamptz
  gateId        String?        @map("gate_id") @db.Uuid
  gate          Gate?          @relation(fields: [gateId, eventId], references: [id, eventId], onDelete: Restrict)
  issuance      TicketIssuance @relation(fields: [orderId], references: [orderId], onDelete: Restrict)
  secrets       TicketSecret[]
  checkins      CheckinLog[]
  freezes       TicketFreeze[]
  id             String         @id @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  orderItemId    String         @map("order_item_id") @db.Uuid
  unitIndex      Int            @map("unit_index")
  eventId        String         @map("event_id") @db.Uuid
  organizerId    String?        @map("organizer_id") @db.Uuid
  itemType       String         @map("item_type")
  refId          String         @map("ref_id") @db.Uuid
  seatId         String?        @map("seat_id") @db.Uuid
  ownerUserId    String         @map("owner_user_id") @db.Uuid
  unitPriceVnd   BigInt         @map("unit_price_vnd")
  status         String         @default("ACTIVE")
  secretVersion  Int            @default(1) @map("secret_version")
  version        Int            @default(1)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @default(now()) @map("updated_at") @db.Timestamptz
  issuance       TicketIssuance @relation(fields: [orderId], references: [orderId], onDelete: Restrict)
  secrets        TicketSecret[]
  nftMint        NftMint?

  @@unique([orderItemId, unitIndex], map: "uq_ticket_order_item_unit")
  @@index([orderId])
  @@index([ownerUserId, id])
  @@map("tickets")
}

model TicketSecret {
  id        String    @id @db.Uuid
  ticketId  String    @map("ticket_id") @db.Uuid
  version   Int
  secretEnc Bytes     @map("secret_enc")
  keyId     String    @map("key_id")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@unique([ticketId, version], map: "uq_ticket_secret_version")
  @@map("ticket_secrets")
}

model TicketFreeze {
  id               String   @id @db.Uuid
  ticketId         String   @map("ticket_id") @db.Uuid
  sellerId         String   @map("seller_id") @db.Uuid
  eventId          String   @map("event_id") @db.Uuid
  organizerId      String?  @map("organizer_id") @db.Uuid
  originalPriceVnd BigInt   @map("original_price_vnd")
  status           String
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz
  ticket           Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@map("ticket_freezes")
}

model TicketEvent {
  id            String   @id @db.Uuid
  organizerId   String   @map("organizer_id") @db.Uuid
  cancelled     Boolean  @default(false)
  sourceVersion Int      @map("source_version")
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz
  gates         Gate[]

  @@unique([id, organizerId], map: "uq_ticket_event_organizer")
  @@map("ticket_events")
}

model Gate {
  id             String            @id @db.Uuid
  eventId        String            @map("event_id") @db.Uuid
  organizerId    String            @map("organizer_id") @db.Uuid
  name           String            @db.VarChar(100)
  version        Int               @default(1)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @default(now()) @map("updated_at") @db.Timestamptz
  event          TicketEvent       @relation(fields: [eventId, organizerId], references: [id, organizerId], onDelete: Restrict)
  tickets        Ticket[]
  assignments    StaffAssignment[]
  checkins       CheckinLog[]
  offlineDevices OfflineDevice[]

  @@unique([id, eventId], map: "uq_gate_event")
  @@unique([id, eventId, organizerId], map: "uq_gate_event_organizer")
  @@unique([eventId, name], map: "uq_gate_name")
  @@map("gates")
}

model StaffAssignment {
  id          String    @id @db.Uuid
  gateId      String    @map("gate_id") @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  organizerId String    @map("organizer_id") @db.Uuid
  staffUserId String    @map("staff_user_id") @db.Uuid
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  gate        Gate      @relation(fields: [gateId, eventId, organizerId], references: [id, eventId, organizerId], onDelete: Restrict)

  @@unique([gateId, staffUserId], map: "uq_staff_gate")
  @@index([staffUserId, id])
  @@map("staff_assignments")
}

model TicketRequest {
  id          String   @id @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  scope       String
  requestKey  String   @map("request_key") @db.Uuid
  fingerprint String   @db.VarChar(64)
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([actorId, scope, requestKey], map: "uq_ticket_request")
  @@map("ticket_requests")
}

model CheckinLog {
  id                String            @id @db.Uuid
  ticketId          String?           @map("ticket_id") @db.Uuid
  scannedTicketId   String            @map("scanned_ticket_id") @db.Uuid
  gateId            String            @map("gate_id") @db.Uuid
  eventId           String            @map("event_id") @db.Uuid
  organizerId       String            @map("organizer_id") @db.Uuid
  staffUserId       String            @map("staff_user_id") @db.Uuid
  result            String
  offline           Boolean           @default(false)
  scannedAt         DateTime          @map("scanned_at") @db.Timestamptz
  batchId           String?           @map("batch_id") @db.Uuid
  deviceId          String?           @map("device_id") @db.Uuid
  sourceScanId      String?           @map("source_scan_id") @db.Uuid
  sourceFingerprint String?           @map("source_fingerprint") @db.VarChar(64)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  ticket            Ticket?           @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  gate              Gate              @relation(fields: [gateId, eventId, organizerId], references: [id, eventId, organizerId], onDelete: Restrict)
  batch             OfflineSyncBatch? @relation(fields: [batchId, deviceId, gateId, eventId, organizerId, staffUserId], references: [id, deviceId, gateId, eventId, organizerId, staffUserId], onDelete: Restrict, map: "fk_checkin_offline_batch")
  device            OfflineDevice?    @relation(fields: [deviceId, gateId, eventId, organizerId, staffUserId], references: [id, gateId, eventId, organizerId, staffUserId], onDelete: Restrict, map: "fk_checkin_device")

  @@index([gateId, id])
  @@map("checkin_logs")
}

model OfflineDevice {
  id          String             @id @db.Uuid
  gateId      String             @map("gate_id") @db.Uuid
  eventId     String             @map("event_id") @db.Uuid
  organizerId String             @map("organizer_id") @db.Uuid
  staffUserId String             @map("staff_user_id") @db.Uuid
  packageId   String             @map("package_id") @db.Uuid
  secretEnc   Bytes              @map("secret_enc")
  keyId       String             @map("key_id")
  issuedAt    DateTime           @map("issued_at") @db.Timestamptz
  expiresAt   DateTime           @map("expires_at") @db.Timestamptz
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  gate        Gate               @relation(fields: [gateId, eventId, organizerId], references: [id, eventId, organizerId], onDelete: Restrict)
  batches     OfflineSyncBatch[]
  checkins    CheckinLog[]

  @@unique([id, gateId, eventId, organizerId, staffUserId], map: "uq_offline_device_context")
  @@index([staffUserId, id])
  @@map("offline_devices")
}

model OfflineSyncBatch {
  id            String        @id @db.Uuid
  deviceId      String        @map("device_id") @db.Uuid
  gateId        String        @map("gate_id") @db.Uuid
  eventId       String        @map("event_id") @db.Uuid
  organizerId   String        @map("organizer_id") @db.Uuid
  staffUserId   String        @map("staff_user_id") @db.Uuid
  fingerprint   String        @db.VarChar(64)
  recordCount   Int           @map("record_count")
  conflictCount Int           @map("conflict_count")
  response      Json
  receivedAt    DateTime      @map("received_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  device        OfflineDevice @relation(fields: [deviceId, gateId, eventId, organizerId, staffUserId], references: [id, gateId, eventId, organizerId, staffUserId], onDelete: Restrict, map: "fk_offline_batch_device")
  checkins      CheckinLog[]

  @@unique([id, deviceId, gateId, eventId, organizerId, staffUserId], map: "uq_offline_batch_context")
  @@map("offline_sync_batches")
model NftMint {
  id              String    @id @db.Uuid
  ticketId        String    @unique(map: "uq_nft_ticket") @map("ticket_id") @db.Uuid
  eventId         String    @map("event_id") @db.Uuid
  fingerprint     String    @db.VarChar(64)
  sourceMessageId String    @map("source_message_id") @db.Uuid
  traceId         String    @map("trace_id")
  status          String    @default("PENDING")
  attempts        Int       @default(0)
  nextAttemptAt   DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz
  leaseUntil      DateTime? @map("lease_until") @db.Timestamptz
  provider        String    @default("MOCK")
  tokenId         String?   @map("token_id")
  txHash          String?   @map("tx_hash")
  metadataUri     String?   @map("metadata_uri")
  mockReference   String?   @map("mock_reference")
  lastError       String?   @map("last_error")
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  ticket          Ticket    @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@map("nft_mints")
}

model OutboxEvent {
  id          String    @id @db.Uuid
  topic       String
  messageKey  String    @map("message_key")
  eventType   String    @map("event_type")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  publishedAt DateTime? @map("published_at") @db.Timestamptz

  @@map("outbox_events")
}

model ProcessedEvent {
  messageId   String   @map("message_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@id([messageId, consumer])
  @@map("processed_events")
}
